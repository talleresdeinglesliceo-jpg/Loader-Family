-- HILOS LIGEROS Y LOOP PRINCIPAL
-- ==========================================
local cachedCoins = {}
local coinCursor = 1
local cachedVotePart = nil
local lastVoteMapName = ""

task.spawn(function()
	while Window do
		if State.FarmCoins then
			local list = {}
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("BasePart") and obj.Parent then
					local lower = string.lower(obj.Name)
					if lower == "coin_server" or lower == "coin" or string.find(lower, "coin") then
						table.insert(list, obj)
					end
				end
			end
			cachedCoins = list
		end

		if State.AutoVoteMap then
			local chosen = string.lower(State.SelectedMap or "")
			if chosen ~= lastVoteMapName or not cachedVotePart or not cachedVotePart.Parent then
				lastVoteMapName = chosen
				cachedVotePart = nil
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj:IsA("BasePart") and string.find(string.lower(obj.Name), chosen) then
						cachedVotePart = obj
						break
					end
				end
			end
		end

		task.wait(1.5)
	end
end)

local frameCounter = 0
local elapsedStats = 0
local currentFPS = 60
local lastCoinTp = 0
local lastEspUpdate = 0

RunService.RenderStepped:Connect(function(dt)
	frameCounter += 1
	elapsedStats += dt
	if elapsedStats >= 0.45 then
		currentFPS = math.floor((frameCounter / elapsedStats) + 0.5)
		local pingMs = getCurrentPingMs()
		frameCounter = 0
		elapsedStats = 0
		pcall(function()
			PerfParagraph:SetDesc("FPS: " .. tostring(currentFPS) .. "  |  MS: " .. tostring(pingMs) .. " ms")
		end)
	end

	local now = os.clock()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if hum and State.SpeedEnabled and hum.WalkSpeed ~= State.CustomSpeed then
		hum.WalkSpeed = State.CustomSpeed
	end

	if root and hum and State.FlyEnabled then
		local lv = ensureFlyPhysics(root, hum)
		if lv then
			local moveDir = hum.MoveDirection or Vector3.zero
			local vertical = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical -= 1 end
			lv.VectorVelocity = Vector3.new(moveDir.X * State.FlySpeed, vertical * State.FlySpeed, moveDir.Z * State.FlySpeed)
		end
	elseif flyLinearVel then
		clearFlyPhysics()
	end

	if State.AutoGrabGun and root then
		local gunDrop = Workspace:FindFirstChild("GunDrop", true)
		if gunDrop and gunDrop:IsA("BasePart") then safeTouch(gunDrop, root) end
	end

	if State.FarmCoins and root then
		if isCoinBagFull() then
			State.FarmCoins = false
		elseif (now - lastCoinTp) >= 0.16 and #cachedCoins > 0 then
			if coinCursor > #cachedCoins then coinCursor = 1 end
			local coin = cachedCoins[coinCursor]
			coinCursor += 1
			if coin and coin.Parent then
				lastCoinTp = now
				pcall(function() root.CFrame = coin.CFrame * CFrame.new(0, 1.5, 0) end)
				safeTouch(coin, root)
			end
		end
	end

	if State.AutoShotMurder then
		runRaycastSilentAutoShoot()
	else
		activeSilentAimPos = nil
	end

	if State.AutoKillEnabled and char and hum and root then
		runAutoKillStep(char, hum, root)
	end

	if State.CamLockEnabled and Camera and root and hasGunEquippedOrOwned() then
		local torsoPart, _, murderChar = getMurderTargetInfo()
		if torsoPart and detectMurderByRaycast(torsoPart, murderChar) then
			pcall(function() Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, torsoPart.Position) end)
		end
	end

	if State.AutoVoteMap and root and cachedVotePart and cachedVotePart.Parent then
		pcall(function() root.CFrame = cachedVotePart.CFrame + Vector3.new(0, 3, 0) end)
	end

	if State.ESPRoles and (now - lastEspUpdate) >= 0.35 then
		lastEspUpdate = now
		pcall(updateESPRoles)
	end

	if State.HitboxExpander and hitboxDirty then
		pcall(updateHitboxes)
	end
end)
