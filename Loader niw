-- HITBOX EXPANDER
-- ==========================================
local OriginalHitboxSizes = setmetatable({}, { __mode = "k" })
local hitboxDirty = true

local function restoreSingleHitbox(hrp)
	if not hrp or not hrp:IsA("BasePart") then return end
	local origSize = OriginalHitboxSizes[hrp] or Vector3.new(2, 2, 1)
	pcall(function()
		hrp.Size = origSize
		hrp.Transparency = 1
		hrp.CanCollide = false
		hrp.Massless = false
	end)
end

local function resetHitboxes()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then restoreSingleHitbox(hrp) end
		end
	end
	hitboxDirty = false
end

local function updateHitboxes()
	local targetVec = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				if OriginalHitboxSizes[hrp] == nil then OriginalHitboxSizes[hrp] = hrp.Size end
				if State.HitboxExpander then
					pcall(function()
						hrp.CanCollide = false
						hrp.Massless = true
						if hrp.Size ~= targetVec then hrp.Size = targetVec end
						if hrp.Transparency ~= State.HitboxTransparency then hrp.Transparency = State.HitboxTransparency end
					end)
				else
					restoreSingleHitbox(hrp)
				end
			end
		end
	end
	hitboxDirty = false
end

