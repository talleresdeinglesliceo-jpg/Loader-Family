local function serializeState()
	return {
		SkyboxName = State.SkyboxName, SpeedEnabled = State.SpeedEnabled, CustomSpeed = State.CustomSpeed,
		InfinityJump = State.InfinityJump, Noclip = State.Noclip, ESPRoles = State.ESPRoles,
		CamLockEnabled = State.CamLockEnabled, AutoKillEnabled = State.AutoKillEnabled,
		AutoShotMurder = State.AutoShotMurder, AutoGrabGun = State.AutoGrabGun, FarmCoins = State.FarmCoins,
		CoinBagLimit = State.CoinBagLimit, FPSBoost = State.FPSBoost, FlyEnabled = State.FlyEnabled,
		FlySpeed = State.FlySpeed, AntiAFK = State.AntiAFK, HitboxExpander = State.HitboxExpander,
		HitboxSize = State.HitboxSize, HitboxTransparency = State.HitboxTransparency,
		SelectedMap = State.SelectedMap, AutoVoteMap = State.AutoVoteMap
	}
end

local function applyLoadedConfig(data)
	if type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		if State[k] ~= nil then State[k] = v end
	end
	applySkyboxByName(State.SkyboxName)
	applyFPSBoost(State.FPSBoost)
	setFlyState(State.FlyEnabled)
	setNoclipState(State.Noclip)
	hitboxDirty = true
	if not State.ESPRoles then clearESP() else updateESPRoles() end
	if not State.HitboxExpander then resetHitboxes() else updateHitboxes() end
	return true
end

