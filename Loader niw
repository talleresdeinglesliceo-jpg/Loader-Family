local function getRoleType(plr)
	local backpack = plr:FindFirstChild("Backpack")
	local char = plr.Character
	local function hasTool(container, keyword)
		if not container then return false end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), keyword) then return true end
		end
		return false
	end
	if hasTool(char, "knife") or hasTool(backpack, "knife") then return "Murder" end
	if hasTool(char, "gun") or hasTool(backpack, "gun") or hasTool(char, "revolver") or hasTool(backpack, "revolver") then return "Sheriff" end
	return "Innocent"
end

local function isGunTool(obj)
	if not obj or not obj:IsA("Tool") then return false end
	local n = string.lower(obj.Name)
	return string.find(n, "gun") ~= nil or string.find(n, "revolver") ~= nil or string.find(n, "pistol") ~= nil
end

local function isKnifeTool(obj)
	if not obj or not obj:IsA("Tool") then return false end
	return string.find(string.lower(obj.Name), "knife") ~= nil
end

local function getEquippedOrOwnedGun()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if isGunTool(child) then return child end
		end
	end
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if isGunTool(child) then return child end
