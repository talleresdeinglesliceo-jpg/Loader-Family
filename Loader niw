local function getMurderTargetInfo()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and getRoleType(plr) == "Murder" then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum and hum.Health > 0 then
				local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
				local head = char:FindFirstChild("Head")
				local aimPart = (head and head:IsA("BasePart") and head) or (torso and torso:IsA("BasePart") and torso)
				if torso and torso:IsA("BasePart") and aimPart then
					return torso, aimPart, plr, char
				end
			end
		end
	end
	return nil, nil, nil, nil
end

local function getMurderTorsoPart()
	return select(1, getMurderTargetInfo())
end

local function detectMurderByRaycast(targetPart, targetChar)
	if not targetPart or not targetChar then return false end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {}
	if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
	if Camera then table.insert(ignoreList, Camera) end
	rayParams.FilterDescendantsInstances = ignoreList

	local origin = Camera and Camera.CFrame.Position or nil
	if not origin then
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if root then origin = root.Position + Vector3.new(0, 1.5, 0) end
	end
	if not origin then return false end

	local delta = targetPart.Position - origin
	local dist = delta.Magnitude
	if dist <= 0.1 then return true end

	local hit = Workspace:Raycast(origin, delta.Unit * (dist + 2), rayParams)
	if hit and hit.Instance then
		return hit.Instance:IsDescendantOf(targetChar)
	end
	return true
end

local function getAliveTargetsInMatch()
	local targets = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and hum and hum.Health > 0 and root then
				table.insert(targets, { root = root })
			end
		end
	end
	return targets
end

local autoKillIndex = 1
local lastAutoKillStep = 0

local function runAutoKillStep(myChar, myHum, myRoot)
	if not State.AutoKillEnabled or not myChar or not myHum or not myRoot or myHum.Health <= 0 then return end
	local now = os.clock()
	if (now - lastAutoKillStep) < 0.22 then return end

	local equippedTool = myChar:FindFirstChildOfClass("Tool")
	local gunTool = getEquippedOrOwnedGun()
	local knifeTool = getEquippedOrOwnedKnife()

	if gunTool then
		if equippedTool ~= gunTool and not equippedTool then
			pcall(function() myHum:EquipTool(gunTool) end)
		end
		local murderTorso = getMurderTorsoPart()
		if murderTorso then
			lastAutoKillStep = now
			pcall(function() myRoot.CFrame = murderTorso.CFrame * CFrame.new(0, 0, 3.8) end)
		end
		return
	end

	if knifeTool then
		if equippedTool ~= knifeTool and not equippedTool then
			pcall(function() myHum:EquipTool(knifeTool) end)
		end
		local targets = getAliveTargetsInMatch()
		if #targets > 0 then
			if autoKillIndex > #targets then autoKillIndex = 1 end
			local chosen = targets[autoKillIndex]
			autoKillIndex += 1
			if chosen and chosen.root then
				lastAutoKillStep = now
				pcall(function() myRoot.CFrame = chosen.root.CFrame * CFrame.new(0, 0, 3.2) end)
			end
		end
	end
end

local activeSilentAimPos = nil
local lastAutoShotTime = 0

local function triggerGunFire(gunTool, targetPos)
	if not gunTool or not targetPos then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum or hum.Health <= 0 then return end

	if gunTool.Parent ~= char then
		pcall(function() hum:EquipTool(gunTool) end)
	end

	local firedRemote = false
	for _, desc in ipairs(gunTool:GetDescendants()) do
		if desc:IsA("RemoteEvent") then
			pcall(function() desc:FireServer(targetPos) end)
			firedRemote = true
		end
	end

	if not firedRemote then
		pcall(function() gunTool:Activate() end)
	end
end

local function runRaycastSilentAutoShoot()
	if not State.AutoShotMurder then
		activeSilentAimPos = nil
		return
	end
	local gunTool = getEquippedOrOwnedGun()
	if not gunTool then
		activeSilentAimPos = nil
		return
	end
	local _, aimPart, _, murderChar = getMurderTargetInfo()
	if not aimPart or not murderChar or not detectMurderByRaycast(aimPart, murderChar) then
		activeSilentAimPos = nil
		return
	end
	activeSilentAimPos = aimPart.Position
	local now = os.clock()
	if (now - lastAutoShotTime) >= 0.18 then
		lastAutoShotTime = now
		triggerGunFire(gunTool, activeSilentAimPos)
	end
end

pcall(function()
	if typeof(hookmetamethod) == "function" then
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if activeSilentAimPos and self == Workspace then
				local method = getnamecallmethod()
				if method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
					local args = { ... }
					if method == "Raycast" and typeof(args[1]) == "Vector3" then
						args[2] = (activeSilentAimPos - args[1]).Unit * 500
						return oldNamecall(self, unpack(args))
					elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") and typeof(args[1]) == "Ray" then
						local origin = args[1].Origin
						args[1] = Ray.new(origin, (activeSilentAimPos - origin).Unit * 500)
						return oldNamecall(self, unpack(args))
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	end
end)

local function isCoinBagFull()
	local bagLimit = tonumber(State.CoinBagLimit) or 40
	local function checkContainer(container)
		if not container then return false end
		for _, child in ipairs(container:GetDescendants()) do
			if child:IsA("IntValue") or child:IsA("NumberValue") then
				local lower = string.lower(child.Name)
				if lower == "coins" or lower == "coinbag" or lower == "bag" or string.find(lower, "coin") then
					if tonumber(child.Value) and tonumber(child.Value) >= bagLimit then return true end
				end
			elseif child:IsA("TextLabel") or child:IsA("TextButton") then
				local txt = string.lower(child.Text or "")
				if string.find(txt, "bag full") or string.find(txt, "bolsa llena") or string.find(txt, "max") then return true end
				local cur, maxV = string.match(txt, "(%d+)%s*/%s*(%d+)")
				if cur and maxV and tonumber(maxV) > 0 and tonumber(cur) >= tonumber(maxV) then return true end
			end
		end
		return false
	end
	return checkContainer(LocalPlayer:FindFirstChild("leaderstats"))
		or checkContainer(LocalPlayer:FindFirstChild("PlayerGui"))
		or checkContainer(LocalPlayer.Character)
end

