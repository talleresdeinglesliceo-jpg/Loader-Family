local function updateESPRoles()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local existingHl = plr.Character:FindFirstChild("FamilyRoleESP")
			local existingTag = plr.Character:FindFirstChild("FamilyRoleTag")
			if State.ESPRoles then
				local role = getRoleType(plr)
				local color = RoleColors[role] or RoleColors.Innocent
				local hl = existingHl or Instance.new("Highlight")
				hl.Name = "FamilyRoleESP"
				hl.Adornee = plr.Character
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.FillColor = color
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.FillTransparency = 0.45
				hl.OutlineTransparency = 0
				hl.Parent = plr.Character
				ensureRoleTag(plr, plr.Character, role, color)
			else
				if existingHl then existingHl:Destroy() end
				if existingTag then existingTag:Destroy() end
			end
		end
	end
end

