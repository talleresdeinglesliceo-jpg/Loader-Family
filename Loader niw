local function safeTouch(part, root)
	if not part or not root or not part:IsA("BasePart") then return end
	if typeof(firetouchinterest) == "function" then
		pcall(function()
			firetouchinterest(root, part, 0)
			firetouchinterest(root, part, 1)
		end)
	end
end

local function detectExecutorName()
	for _, fn in ipairs({ identifyexecutor, getexecutorname }) do
		if typeof(fn) == "function" then
			local ok, name = pcall(fn)
			if ok and type(name) == "string" and name ~= "" then return name end
		end
	end
	return "Desconocido"
end

local function copyToClipboard(text)
	for _, fn in ipairs({ setclipboard, toclipboard, set_clipboard }) do
		if typeof(fn) == "function" then
			if pcall(fn, text) then return true end
		end
	end
	return false
end

local function getCurrentPingMs()
	local pingVal = 0
	pcall(function()
		local net = Stats:FindFirstChild("Network")
		local serverStats = net and net:FindFirstChild("ServerStats")
		local dataPing = serverStats and serverStats:FindFirstChild("Data Ping")
		if dataPing and typeof(dataPing.GetValue) == "function" then
			pingVal = tonumber(dataPing:GetValue()) or 0
		elseif dataPing and dataPing.Value then
			pingVal = tonumber(dataPing.Value) or 0
		end
	end)
	if pingVal <= 0 then
		pcall(function()
			pingVal = (LocalPlayer:GetNetworkPing() or 0) * 2000
		end)
	end
	return math.clamp(math.floor(pingVal + 0.5), 0, 9999)
end

